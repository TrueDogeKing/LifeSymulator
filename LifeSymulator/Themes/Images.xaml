<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- default pictures for plants and animals (vector, so they look ok at every zoom) -->
    <!-- change the geometry / colors here to change how they look -->

    <!-- plant: two leaves on a stem -->
    <DrawingImage x:Key="PlantImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L10,0 L10,10 L0,10 Z"/>
                <GeometryDrawing Brush="#FF2E7D32" Geometry="M5,9.5 L5,4.5">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF33691E" Thickness="0.8"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF66BB6A" Geometry="M5,5 C2,5 1,3 1.5,1 C4,1 5,3 5,5 Z"/>
                <GeometryDrawing Brush="#FF43A047" Geometry="M5,6 C8,6 9,4 8.5,2 C6,2 5,4 5,6 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- animal: little bug -->
    <DrawingImage x:Key="AnimalImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L10,0 L10,10 L0,10 Z"/>
                <GeometryDrawing Brush="#FFD84315">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="5,6" RadiusX="3.2" RadiusY="3.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF3E2723">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="5,2.4" RadiusX="1.8" RadiusY="1.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF3E2723">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="3.8,5.2" RadiusX="0.7" RadiusY="0.7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF3E2723">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="6.2,7" RadiusX="0.7" RadiusY="0.7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
