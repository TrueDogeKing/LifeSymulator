<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- change colors here to change the look of the whole app -->

    <!-- board -->
    <SolidColorBrush x:Key="EmptyBrush" Color="#FFF4EEDC"/>
    <SolidColorBrush x:Key="PlantBrush" Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="AnimalBrush" Color="#FFD84315"/>
    <SolidColorBrush x:Key="BothBrush" Color="#FF8D6E63"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FFDDD5C0"/>
    <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#FF5D5D5D"/>

    <!-- panel and buttons -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#FF607D8B"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF78909C"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FF455A64"/>
    <SolidColorBrush x:Key="ButtonCheckedBrush" Color="#FF2E7D32"/>
    <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="White"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#FF37474F"/>

    <!-- size of one cell in pixels -->
    <sys:Double x:Key="CellSize">10</sys:Double>
</ResourceDictionary>
