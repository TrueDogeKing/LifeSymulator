<Window x:Class="LifeSymulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LifeSymulator"
        mc:Ignorable="d"
        Title="Life Simulator" Height="700" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- board: only the visible part is drawn, scrollbars move the view -->
        <Grid Background="{StaticResource BoardBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <local:BoardView x:Name="board" Margin="5"
                             MouseLeftButtonDown="Board_MouseLeftButtonDown"
                             MouseRightButtonDown="Board_MouseRightButtonDown" MouseRightButtonUp="Board_MouseRightButtonUp"
                             MouseMove="Board_MouseMove" MouseWheel="Board_MouseWheel"/>
            <ScrollBar x:Name="vScroll" Grid.Column="1" Orientation="Vertical" Scroll="ScrollBar_Scroll"/>
            <ScrollBar x:Name="hScroll" Grid.Row="1" Orientation="Horizontal" Scroll="ScrollBar_Scroll"/>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelBrush}">
        <StackPanel Margin="5">
            <TextBlock Text="Board size" Style="{StaticResource HeaderText}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="W:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtWidth" Width="50" Text="50" Margin="3"/>
                <TextBlock Text="H:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtHeight" Width="50" Text="50" Margin="3"/>
            </StackPanel>
            <Button x:Name="btnNew" Content="New board" Click="btnNew_Click" Margin="2"/>
            <Button x:Name="btnClear" Content="Clear" Click="btnClear_Click" Margin="2"/>
            <Button x:Name="btnRandom" Content="Random" Click="btnRandom_Click" Margin="2"/>
            <TextBlock Text="Zoom" Style="{StaticResource HeaderText}"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnZoomOut" Content=" - " Click="btnZoomOut_Click" Width="40" Margin="2"/>
                <Button x:Name="btnZoomIn" Content=" + " Click="btnZoomIn_Click" Width="40" Margin="2"/>
                <Button x:Name="btnFit" Content="Fit" Click="btnFit_Click" Width="50" Margin="2"/>
                <TextBlock Text="{Binding CellSize, ElementName=board, StringFormat={}{0:0.0} px}" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>
            <!-- smooth zoom, slider is bound directly to the board -->
            <Slider x:Name="sliderZoom" Minimum="0.5" Maximum="40" Margin="2"
                    Value="{Binding CellSize, ElementName=board, Mode=TwoWay}" PreviewMouseDown="sliderZoom_PreviewMouseDown"/>
            <TextBlock Text="Mouse wheel = zoom, right drag = move" Foreground="Gray" TextWrapping="Wrap" Margin="2,0"/>
            <TextBlock Text="Simulation" Style="{StaticResource HeaderText}"/>
            <Button x:Name="btnStep" Content="Step" Click="btnStep_Click" Margin="2"/>
            <Button x:Name="btnStart" Content="Start" Click="btnStart_Click" Margin="2" Style="{StaticResource StartButtonStyle}"/>
            <TextBlock Text="Speed" Margin="2,5,2,0"/>
            <Slider x:Name="sliderSpeed" Minimum="1" Maximum="30" Value="5" ValueChanged="sliderSpeed_ValueChanged" Margin="2"/>
            <TextBlock x:Name="txtGeneration" Text="Generation: 0" Margin="2"/>
            <TextBlock Text="Rules" Style="{StaticResource HeaderText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="R" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtR" Margin="1"/>
                <TextBlock Grid.Row="1" Text="W" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtW" Margin="1"/>
                <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtB" Margin="1"/>
                <TextBlock Grid.Row="3" Text="P" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtP" Margin="1"/>
                <TextBlock Grid.Row="4" Text="Z" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtZ" Margin="1"/>
                <TextBlock Grid.Row="5" Text="M" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtM" Margin="1"/>
                <TextBlock Grid.Row="6" Text="L" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtL" Margin="1"/>
            </Grid>
            <Button x:Name="btnApply" Content="Apply rules" Click="btnApply_Click" Margin="2"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button x:Name="btnSave" Content="Save" Click="btnSave_Click" Width="100" Margin="2"/>
                <Button x:Name="btnLoad" Content="Load" Click="btnLoad_Click" Width="100" Margin="2"/>
            </StackPanel>
            <TextBlock Text="Statistics" Style="{StaticResource HeaderText}"/>
            <TextBlock x:Name="txtPlants" Text="Plants: 0" Margin="2,0"/>
            <TextBlock x:Name="txtAnimals" Text="Animals: 0" Margin="2,0"/>
            <TextBlock x:Name="txtBirths" Text="Births: 0" Margin="2,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtDeaths" Text="Deaths: 0" Margin="2,0" TextWrapping="Wrap"/>
            <TextBlock Text="Click on a cell to change it (empty -> plant -> animal -> both)" TextWrapping="Wrap" Margin="2,10,2,2" Foreground="Gray"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
